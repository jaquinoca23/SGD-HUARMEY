# Copie este archivo a backend/.env y complete los valores. NUNCA suba .env al repositorio.
# Genere la clave con:
#   python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change-me-solo-desarrollo
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ENABLE_API_DOCS=True

# PostgreSQL (los mismos valores los usa docker-compose.yml)
DB_NAME=huarmy_sgd
DB_USER=huarmy
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# Archivos privados (plantillas DOCX). Fuera de cualquier carpeta pública.
PRIVATE_MEDIA_ROOT=private_media
TEMPLATE_MAX_UPLOAD_MB=5
